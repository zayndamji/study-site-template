{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-site-template/site.schema.json",
  "title": "Study site configuration (site.json)",
  "description": "See docs/configuration.md. Every key except pages has a default.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "template": { "type": "string", "description": "Path to the template (informational)." },
    "site": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "brand": {
          "type": "object",
          "properties": { "text": { "type": ["string", "null"] }, "open": { "type": "string" }, "close": { "type": "string" } }
        },
        "description": { "type": "string" },
        "lang": { "type": "string" },
        "storagePrefix": { "type": "string", "description": "localStorage key prefix; unique per site." },
        "defaultTheme": { "enum": ["system", "light", "dark"] },
        "favicon": { "type": ["string", "null"] },
        "footer": { "type": "string" },
        "pageFooter": { "type": "string" },
        "titleFormat": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "fonts": {
          "type": "object",
          "properties": {
            "css": { "type": ["array", "string"], "items": { "type": "string" } },
            "display": { "type": ["string", "null"] }, "body": { "type": ["string", "null"] },
            "math": { "type": ["string", "null"] }, "mono": { "type": ["string", "null"] }
          }
        },
        "tokens": {
          "type": "object",
          "properties": {
            "all": { "$ref": "#/$defs/tokens" }, "light": { "$ref": "#/$defs/tokens" }, "dark": { "$ref": "#/$defs/tokens" }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "outDir": { "type": "string" }, "contentDir": { "type": "string" }, "staticDir": { "type": "string" },
        "packagesDir": { "type": "string" }, "cacheBust": { "type": "boolean" },
        "css": { "type": "array", "items": { "type": "string" } }, "js": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nav": {
      "type": "object",
      "properties": {
        "picker": { "type": "boolean" }, "prevNext": { "type": "boolean" }, "home": { "type": "string" },
        "prevShort": { "type": "string" }, "nextShort": { "type": "string" },
        "prevLong": { "type": "string" }, "nextLong": { "type": "string" },
        "pickerOption": { "type": "string" }, "showPlanned": { "type": "boolean" }
      }
    },
    "home": {
      "type": "object",
      "properties": {
        "intro": { "type": "object", "properties": { "eyebrow": { "type": "string" }, "tagline": { "type": "string" } } },
        "search": { "type": "boolean" }, "searchPlaceholder": { "type": "string" },
        "filters": { "enum": ["auto", "groups", "kinds", "none"] }, "allLabel": { "type": "string" },
        "columns": { "type": "integer", "minimum": 1, "maximum": 4 }, "showRange": { "type": "boolean" },
        "emptyText": { "type": "string" }, "columnWidths": { "type": ["string", "null"] },
        "after": { "type": "string" }, "afterFile": { "type": ["string", "null"] }
      }
    },
    "kinds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/kind" } },
    "groups": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" }, "note": { "type": "string" }, "sheetNote": { "type": "string" },
          "range": { "type": ["string", "boolean", "null"] }, "filterLabel": { "type": ["string", "null"] }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "title"],
        "properties": {
          "id": { "type": ["string", "integer"] }, "badge": { "type": "string" }, "noun": { "type": "string" }, "short": { "type": "string" }, "kind": { "type": "string" }, "title": { "type": "string" },
          "label": { "type": "string" }, "description": { "type": "string" }, "keywords": { "type": "string" },
          "group": { "type": ["string", "null"] }, "status": { "type": "string" }, "statusLabel": { "type": "string" }, "statusNote": { "type": "string" },
          "file": { "type": "string" }, "source": { "type": "string" }, "storageKey": { "type": "string" }
        }
      }
    },
    "packages": {
      "oneOf": [
        { "type": "object", "additionalProperties": { "type": ["object", "boolean"] } },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  },
  "$defs": {
    "tokens": { "type": "object", "additionalProperties": { "type": "string" } },
    "kind": {
      "type": "object",
      "properties": {
        "noun": { "type": "string" }, "plural": { "type": ["string", "null"] }, "short": { "type": ["string", "null"] },
        "file": { "type": "string" }, "source": { "type": "string" }, "storageKey": { "type": "string" },
        "eyebrow": { "type": "string" }, "rail": { "type": "string" }, "review": { "type": "boolean" },
        "prevNext": { "type": "boolean" }, "numbered": { "type": "boolean" }, "inPicker": { "type": "boolean" },
        "titleFormat": { "type": ["string", "null"] }, "pageFooter": { "type": ["string", "null"] }
      }
    }
  }
}
